-- ==========================================
-- AUTO FARM TAB
-- ==========================================

FarmTab:CreateToggle({
   Name = "Auto Rebirth",
   CurrentValue = false,
   Flag = "AutoRebirthToggle",
   Callback = function(Value)
      getgenv().AutoRebirth = Value
      
      if Value then
         task.spawn(function()
            while getgenv().AutoRebirth do
               local Event = game:GetService("ReplicatedStorage"):FindFirstChild("GameSystems")
               if Event then
                  Event.Remotes.RequestRebirth:FireServer()
               end
               task.wait(1)
            end
         end)
      end
   end,
})

FarmTab:CreateToggle({
   Name = "Auto Collect Coins",
   CurrentValue = false,
   Flag = "AutoCoinsToggle",
   Callback = function(Value)
      getgenv().AutoCoins = Value
      
      if Value then
         task.spawn(function()
            -- First, rename all coin parts to "Coin"
            local collectibles = workspace:FindFirstChild("Collectibles")
            if collectibles then
               for _, coin in pairs(collectibles:GetChildren()) do
                  if string.find(coin.Name, "^Coin_") and coin:IsA("BasePart") then
                     coin.Name = "Coin"
                  end
               end
            end
            
            while getgenv().AutoCoins do
               local player = game.Players.LocalPlayer
               local character = player.Character
               
               if character and character:FindFirstChild("HumanoidRootPart") then
                  local hrp = character.HumanoidRootPart
                  local tweenService = game:GetService("TweenService")
                  
                  -- Look for Collectibles folder
                  local collectibles = workspace:FindFirstChild("Collectibles")
                  
                  if collectibles then
                     -- Find all coins
                     local coins = {}
                     for _, coin in pairs(collectibles:GetChildren()) do
                        if coin.Name == "Coin" and coin:IsA("BasePart") then
                           table.insert(coins, coin)
                        end
                     end
                     
                     -- Process each coin
                     for _, coin in pairs(coins) do
                        local coinPos = coin.Position
                        
                        -- Step 1: Teleport directly to coin
                        hrp.CFrame = CFrame.new(coinPos + Vector3.new(0, 3, 0))
                        task.wait(0.05)
                        
                        -- Step 2: Touch to collect
                        pcall(function()
                           firetouchinterest(hrp, coin, 0)
                           firetouchinterest(hrp, coin, 1)
                        end)
                        task.wait(0.05)
                        
                        -- Step 3: Tween to coin (smooth movement for collision)
                        local tweenInfo = TweenInfo.new(
                            0.15,
                            Enum.EasingStyle.Linear,
                            Enum.EasingDirection.InOut
                        )
                        
                        local goal = {
                            CFrame = CFrame.new(coinPos + Vector3.new(0, 2, 0))
                        }
                        
                        local tween = tweenService:Create(hrp, tweenInfo, goal)
                        tween:Play()
                        task.wait(0.15)
                        
                        -- Step 4: Touch again after tween
                        pcall(function()
                           firetouchinterest(hrp, coin, 0)
                           firetouchinterest(hrp, coin, 1)
                        end)
                        task.wait(0.05)
                        
                        -- Step 5: Move through the coin (walk through it)
                        local walkGoal = {
                            CFrame = CFrame.new(coinPos + Vector3.new(0, 0.5, 0))
                        }
                        local walkTween = tweenService:Create(hrp, tweenInfo, walkGoal)
                        walkTween:Play()
                        task.wait(0.15)
                        
                        -- Step 6: Final touch
                        pcall(function()
                           firetouchinterest(hrp, coin, 0)
                           firetouchinterest(hrp, coin, 1)
                        end)
                        task.wait(0.05)
                     end
                  end
               end
               task.wait(0.2)
            end
         end)
      end
   end,
})

FarmTab:CreateToggle({
