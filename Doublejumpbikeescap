-- 1. Load Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Global Variables for Auto Farm
getgenv().AutoRebirth = false
getgenv().AutoBuyTrails = false
getgenv().AutoBuyAura = false
getgenv().AutoWin = false
getgenv().AutoCoins = false

-- 2. Create Window
local Window = Rayfield:CreateWindow({
   Name = "Gold Hub",
   LoadingTitle = "Loading Gold Hub...",
   LoadingSubtitle = "by GoldBed",
   Theme = "Default",
   
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "GoldHubConfig", 
      FileName = "Settings"
   },
   KeySystem = false
})

-- 3. Create Tabs
local FarmTab = Window:CreateTab("Auto Farm", 4483362458) 
local ShopTab = Window:CreateTab("Auto Buy (Shop)", 4483362458)

-- ==========================================
-- AUTO FARM TAB
-- ==========================================

FarmTab:CreateToggle({
   Name = "Auto Rebirth",
   CurrentValue = false,
   Flag = "AutoRebirthToggle",
   Callback = function(Value)
      getgenv().AutoRebirth = Value
      
      if Value then
         task.spawn(function()
            while getgenv().AutoRebirth do
               local Event = game:GetService("ReplicatedStorage"):FindFirstChild("GameSystems")
               if Event then
                  Event.Remotes.RequestRebirth:FireServer()
               end
               task.wait(1)
            end
         end)
      end
   end,
})

FarmTab:CreateToggle({
   Name = "Auto Collect Coins",
   CurrentValue = false,
   Flag = "AutoCoinsToggle",
   Callback = function(Value)
      getgenv().AutoCoins = Value
      
      if Value then
         task.spawn(function()
            -- First, rename all coin parts to "Coin"
            local collectibles = workspace:FindFirstChild("Collectibles")
            if collectibles then
               for _, coin in pairs(collectibles:GetChildren()) do
                  if string.find(coin.Name, "^Coin_") and coin:IsA("BasePart") then
                     coin.Name = "Coin"
                  end
               end
            end
            
            while getgenv().AutoCoins do
               local player = game.Players.LocalPlayer
               local character = player.Character
               
               if character and character:FindFirstChild("HumanoidRootPart") then
                  local hrp = character.HumanoidRootPart
                  
                  -- Look for Collectibles folder
                  local collectibles = workspace:FindFirstChild("Collectibles")
                  
                  if collectibles then
                     -- Find the closest coin (now named "Coin")
                     local closestCoin = nil
                     local closestDistance = math.huge
                     
                     for _, coin in pairs(collectibles:GetChildren()) do
                        if coin.Name == "Coin" and coin:IsA("BasePart") then
                           local distance = (hrp.Position - coin.Position).Magnitude
                           if distance < closestDistance then
                              closestDistance = distance
                              closestCoin = coin
                           end
                        end
                     end
                     
                     -- Teleport to the closest coin
                     if closestCoin then
                        hrp.CFrame = CFrame.new(closestCoin.Position + Vector3.new(0, 3, 0))
                        task.wait(0.05)
                        
                        -- Try touching to collect
                        pcall(function()
                           firetouchinterest(hrp, closestCoin, 0)
                           firetouchinterest(hrp, closestCoin, 1)
                        end)
                     end
                  end
               end
               task.wait(0.2)
            end
         end)
      end
   end,
})

FarmTab:CreateToggle({
   Name = "Auto Win (Teleport)",
   CurrentValue = false,
   Flag = "AutoWinToggle",
   Callback = function(Value)
      getgenv().AutoWin = Value
      
      if Value then
         task.spawn(function()
            while getgenv().AutoWin do
               local player = game.Players.LocalPlayer
               if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                  player.Character.HumanoidRootPart.CFrame = CFrame.new(-71470.34, 1906.55, 3.67)
               end
               task.wait(0.5)
            end
         end)
      end
   end,
})

