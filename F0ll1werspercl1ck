-- Gold Hub - Auto Farm GUI
-- didnt obfuscate cuz this shit is ass anyways and vibe coded

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/download/1.6.66/main.lua"))()

local Window = WindUI:CreateWindow({
   Title = "Gold Hub",
   Icon = "coins",
   Author = "by Cobalt"
})

-- Services
local Event = game:GetService("ReplicatedStorage").Remotes.Events
local HatchPet = game:GetService("ReplicatedStorage").Remotes.HatchPet
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

-- ===== FPS BOOST =====
-- Disable shadows
Lighting.ShadowSoftness = 0
Lighting.Brightness = 1
Lighting.GlobalShadows = false
Lighting.FogEnd = 1000

-- Disable unnecessary visual effects
pcall(function()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
            v.Enabled = false
        end
        if v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 1
        end
    end
end)

-- Reduce graphics quality
pcall(function()
    game:GetService("UserSettings"):Set("GraphicsSettings", {
        QualityLevel = 1,
        Fullscreen = false,
        Resolution = { X = 480, Y = 854 }
    })
end)

-- Disable unnecessary services
pcall(function()
    game:GetService("RunService"):SetThrottleFpsEnabled(true)
end)

