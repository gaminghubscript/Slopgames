-- ==========================================
-- MOVEMENT
-- ==========================================

RunService.RenderStepped:Connect(function(deltaTime)
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Humanoid = Character:FindFirstChild("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not (Humanoid and RootPart and Humanoid.Health > 0) then return end
    
    if _G.PlayerSpeed and _G.PlayerSpeed > 16 and Humanoid.MoveDirection.Magnitude > 0 then
        local displacement = Humanoid.MoveDirection * ((_G.PlayerSpeed - 16) * deltaTime)
        RootPart.CFrame = RootPart.CFrame + displacement
    end
end)

UserInputService.JumpRequest:Connect(function()
    if not _G.JumpPower or _G.JumpPower <= 50 then return end
    
    local Character = LocalPlayer.Character
    if not Character then return end
    
    local Humanoid = Character:FindFirstChild("Humanoid")
    local RootPart = Character:FindFirstChild("HumanoidRootPart")
    if not (Humanoid and RootPart) then return end
    
    if Humanoid.FloorMaterial ~= Enum.Material.Air then
        RootPart.AssemblyLinearVelocity = Vector3.new(
            RootPart.AssemblyLinearVelocity.X,
            _G.JumpPower,
            RootPart.AssemblyLinearVelocity.Z
        )
    end
end)

-- ==========================================
-- AUTO DESTROY (2 = UNDERNEATH, 1 = IN FRONT)
-- ==========================================

task.spawn(function()
    while true do
        if _G.AutoDestroy then
            pcall(function()
                local Character = LocalPlayer.Character
                if Character then
                    local RootPart = Character:FindFirstChild("HumanoidRootPart")
                    if RootPart then
                        local Event = ReplicatedStorage.Shared.Events.Destruction_Punch
                        local pos = RootPart.Position
                        local look = RootPart.CFrame.LookVector
                        
                        -- PARAMETER 2: BREAK BLOCKS UNDERNEATH
                        for y = -2, -20, -2 do
                            Event:FireServer(2, pos + Vector3.new(0, y, 0))
                            Event:FireServer(2, pos + Vector3.new(3, y, 3))
                            Event:FireServer(2, pos + Vector3.new(-3, y, 3))
                            Event:FireServer(2, pos + Vector3.new(3, y, -3))
                            Event:FireServer(2, pos + Vector3.new(-3, y, -3))
                            Event:FireServer(2, pos + Vector3.new(5, y, 0))
                            Event:FireServer(2, pos + Vector3.new(-5, y, 0))
                            Event:FireServer(2, pos + Vector3.new(0, y, 5))
                            Event:FireServer(2, pos + Vector3.new(0, y, -5))
                        end
                        
                        -- PARAMETER 1: BREAK BLOCKS IN FRONT
                        for dist = 2, 15, 2 do
                            Event:FireServer(1, pos + look * dist)
                            Event:FireServer(1, pos + look * dist + Vector3.new(0, 2, 0))
                            Event:FireServer(1, pos + look * dist + Vector3.new(0, -2, 0))
                            Event:FireServer(1, pos + look * dist + Vector3.new(2, 0, 0))
                            Event:FireServer(1, pos + look * dist + Vector3.new(-2, 0, 0))
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

