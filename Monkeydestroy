-- ==========================================
-- AUTO THROW
-- ==========================================

task.spawn(function()
    while true do
        if _G.AutoThrow then
            pcall(function()
                local Character = LocalPlayer.Character
                if Character then
                    local RootPart = Character:FindFirstChild("HumanoidRootPart")
                    if RootPart then
                        local Event = ReplicatedStorage.Shared.Events.Chunk_Throw
                        local power = _G.ThrowPower / 100
                        local pos = RootPart.Position
                        
                        for i = 1, 10 do
                            local theta = math.random() * math.pi * 2
                            local phi = math.random() * math.pi
                            
                            local direction = Vector3.new(
                                math.sin(phi) * math.cos(theta),
                                math.sin(phi) * math.sin(theta),
                                math.cos(phi)
                            )
                            
                            local position = pos + Vector3.new(
                                math.random(-10, 10),
                                math.random(-5, 5),
                                math.random(-10, 10)
                            )
                            
                            local randomPower = power * (0.7 + math.random() * 0.6)
                            local finalDirection = direction * randomPower
                            
                            Event:FireServer(position, finalDirection)
                        end
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

