-- 🚀 CFRAME SPEED BYPASS 🚀
-- This ignores the game's anti-cheat by physically pushing you forward
RunService.RenderStepped:Connect(function(deltaTime)
    local Character = LocalPlayer.Character
    if Character then
        local Humanoid = Character:FindFirstChild("Humanoid")
        local RootPart = Character:FindFirstChild("HumanoidRootPart")

        if Humanoid and RootPart and Humanoid.Health > 0 and not Humanoid.SeatPart then
            if _G.PlayerSpeed and _G.PlayerSpeed > 16 then
                -- Check if the player is currently pressing movement keys
                if Humanoid.MoveDirection.Magnitude > 0 then
                    -- Calculate how much extra distance to move to match the slider
                    local extraSpeed = _G.PlayerSpeed - 16
                    local displacement = Humanoid.MoveDirection * (extraSpeed * deltaTime)
                    RootPart.CFrame = RootPart.CFrame + displacement
                end
            end
        end
    end
end)

-- 🚀 VELOCITY JUMP BYPASS 🚀
-- Forces the character upward instead of relying on default jump properties
UserInputService.JumpRequest:Connect(function()
    if _G.JumpPower and _G.JumpPower > 50 then
        local Character = LocalPlayer.Character
        if Character then
            local Humanoid = Character:FindFirstChild("Humanoid")
            local RootPart = Character:FindFirstChild("HumanoidRootPart")

            -- Check if touching the ground so you don't infinitely fly
            if Humanoid and RootPart and (Humanoid.FloorMaterial ~= Enum.Material.Air) then
                -- Apply raw upward force
                RootPart.AssemblyLinearVelocity = Vector3.new(
                    RootPart.AssemblyLinearVelocity.X, 
                    _G.JumpPower, 
                    RootPart.AssemblyLinearVelocity.Z
                )
            end
        end
    end
end)

